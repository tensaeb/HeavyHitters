<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HEAVY HITTER | COMMAND</title>
    <link href="https://fonts.googleapis.com/css2?family=Syncopate:wght@700&family=Inter:wght@300;400;600;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --glass: rgba(255, 255, 255, 0.03);
            --glass-thick: rgba(255, 255, 255, 0.08);
            --border: rgba(255, 255, 255, 0.1);
            --work-neon: #00ff88;
            --rest-neon: #ff3d3d;
            --occupied-color: #ffcc00;
            --bg-base: #0a0a0c;
        }

        * { box-sizing: border-box; }

        body {
            background-color: var(--bg-base);
            color: white;
            font-family: 'Inter', sans-serif;
            margin: 0;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            transition: background 0.8s ease;
            overflow-x: hidden;
            overflow-y: auto;
        }

        .main-container {
            width: 100%;
            max-width: 1400px;
            padding: 2rem;
            display: flex;
            flex-direction: column;
            gap: 2rem;
        }

        
        .timer-card {
            background: var(--glass);
            border: 1px solid var(--border);
            border-radius: 40px;
            padding: 2.5rem;
            text-align: center;
            backdrop-filter: blur(10px);
            box-shadow: 0 20px 50px rgba(0,0,0,0.3);
        }

        .round-type {
            font-family: 'Syncopate', sans-serif;
            font-size: 1.2rem;
            letter-spacing: 12px;
            margin-bottom: 0.5rem;
            color: var(--work-neon);
            text-transform: uppercase;
        }

        #timer-display {
            font-size: clamp(5rem, 15vw, 10rem);
            font-weight: 800;
            line-height: 1;
            font-variant-numeric: tabular-nums;
            margin: 0;
        }

        .bag-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1.5rem;
            width: 100%;
        }

        .bag-card {
            background: var(--glass);
            border: 1px solid var(--border);
            border-radius: 24px;
            padding: 1.5rem;
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
        }

        .bag-card:hover {
            transform: translateY(-5px);
            background: var(--glass-thick);
            border-color: rgba(255,255,255,0.2);
        }

        .bag-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
        }

        .station-info {
            display: flex;
            flex-direction: column;
        }

        .label {
            font-size: 0.65rem;
            font-weight: 600;
            letter-spacing: 1px;
            opacity: 0.5;
            text-transform: uppercase;
        }

        .station-number {
            font-size: 2rem;
            font-weight: 800;
            line-height: 1;
        }

        .status-indicator {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            margin-top: 5px;
        }

        
        .available .status-indicator { background: var(--work-neon); box-shadow: 0 0 15px var(--work-neon); }
        .occupied .status-indicator { background: var(--occupied-color); box-shadow: 0 0 15px var(--occupied-color); }
        .maintenance .status-indicator { background: var(--rest-neon); box-shadow: 0 0 15px var(--rest-neon); }

        
        form { margin: 0; width: 100%; }

        button {
            width: 100%;
            background: var(--glass-thick);
            border: 1px solid var(--border);
            color: white;
            padding: 0.75rem;
            border-radius: 12px;
            cursor: pointer;
            font-weight: 700;
            text-transform: uppercase;
            font-size: 0.7rem;
            letter-spacing: 1px;
            transition: all 0.2s;
        }

        button:hover {
            background: white;
            color: black;
        }

        .bag-card.available button { border-color: rgba(0, 255, 136, 0.3); }
        .bag-card.occupied button { border-color: rgba(255, 204, 0, 0.3); }
        .bag-card.maintenance button { border-color: rgba(255, 61, 61, 0.3); }

        
        @media (max-width: 600px) {
            .main-container { padding: 1rem; }
            .timer-card { padding: 1.5rem; border-radius: 25px; }
            .bag-grid { grid-template-columns: repeat(2, 1fr); gap: 0.75rem; }
        }
    </style>
</head>
<body id="dynamic-bg">
    <div class="main-container">
        <header class="timer-card">
            <div id="status-text" class="round-type">WORK</div>
            <h1 id="timer-display">03:00</h1>
        </header>

        <main class="bag-grid">
            #for(bag in bags):
            <div class="bag-card #(bag.status)">
                <div class="bag-header">
                    <div class="station-info">
                        <span class="label">Station</span>
                        <span class="station-number">#(bag.id)</span>
                    </div>
                    <div class="status-indicator"></div>
                </div>
                
                <form action="/toggle/#(bag.id)" method="POST">
                    <button type="submit">#(bag.status)</button>
                </form>
            </div>
            #endfor
        </main>
    </div>

    <script>
        let timeLeft = 180;
        let isWork = true;
        const bg = document.getElementById('dynamic-bg');
        const timerText = document.getElementById('timer-display');
        const statusText = document.getElementById('status-text');

        function updateTimer() {
            const mins = Math.floor(timeLeft / 60);
            const secs = timeLeft % 60;
            
            const displayMins = mins;
            const displaySecs = secs.toString().padStart(2, '0');
            
            timerText.innerText = displayMins + ":" + displaySecs

            if (timeLeft <= 0) {
                isWork = !isWork;
                timeLeft = isWork ? 180 : 60;
                
                statusText.innerText = isWork ? "WORK" : "REST";
                bg.style.backgroundColor = isWork ? "#0a0a0c" : "#1a0505";
                statusText.style.color = isWork ? "var(--work-neon)" : "var(--rest-neon)";
            }
            timeLeft--;
        }

        updateTimer();

        setInterval(updateTimer, 1000);
    </script>
</body>
</html>
